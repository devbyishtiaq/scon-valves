# Cloudinary — hero background video
# Cloud name from your Cloudinary dashboard (Settings → Product environment)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Public ID of the uploaded hero video, WITHOUT the file extension.
# e.g. a video at .../video/upload/v1730000000/hero/scon-hero.mp4  ->  hero/scon-hero
NEXT_PUBLIC_CLOUDINARY_HERO_VIDEO=
